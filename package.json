{
  "name": "pilihpendidikan",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.5",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "tsc --noEmit && turbo typecheck",
    "test": "turbo test",
    "dev:home": "turbo dev -F home...",
    "dev:cv": "turbo dev -F cv...",
    "dev:invoice": "turbo dev -F invoice...",
    "dev:portfolio": "turbo dev -F portfolio...",
    "dev:jobs": "turbo dev -F jobs...",
    "dev:design": "turbo dev -F design",
    "dev:api": "turbo dev -F api",
    "check": "biome check && turbo lint && bun run lint:typography && bun run parity:typography && bun run parity:twmerge && bun run parity:showcase && bun run parity:cv-templates && bun run contracts:check && bun run test && bun run audit",
    "contracts:check": "bun run --cwd packages/jobs-contracts check && bun run --cwd apps/jobs-cli contracts:check",
    "e2e": "bun test e2e --timeout 900000",
    "audit": "bun audit && bun run audit:python",
    "audit:python": "sh scripts/require-uv.sh && uv --color never export --project apps/jobs-cli --frozen --format requirements-txt --no-emit-project --all-groups --quiet | uv run --project apps/jobs-cli --frozen pip-audit --strict --disable-pip --progress-spinner off -r /dev/stdin",
    "audit:ci": "bun audit --prod",
    "fix": "biome check --write",
    "lint:typography": "bash scripts/lint-typography.sh",
    "parity:typography": "bun scripts/check-typography-parity.ts",
    "parity:twmerge": "bun scripts/check-twmerge-typography-config.ts",
    "parity:showcase": "bun scripts/check-showcase-coverage.ts",
    "parity:cv-templates": "bun scripts/check-cv-template-parity.ts --base HEAD"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@biomejs/biome": "2.5.15",
    "@pilihpendidikan/config": "workspace:*",
    "@types/node": "^26.6.4",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "sharp": "0.35.5"
  }
}
