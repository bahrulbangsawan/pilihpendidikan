    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-phone-number-input": "^3.4.18",
    "react-resizable-panels": "^4.14.4",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
