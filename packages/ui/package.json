{
  "name": "@rulisme/ui",
  "private": false,
  "type": "module",
  "version": "0.0.1",
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    "./styles/shadcn.css": "./src/styles/shadcn.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "watch:js": "vite build --watch",
    "watch:types": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist --rootDir src --watch",
    "build": "vite build --emptyOutDir && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist --rootDir src",
    "dev": "bun run build && bun run --parallel watch:js watch:types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  },
