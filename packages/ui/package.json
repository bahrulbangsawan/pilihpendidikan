{
  "name": "@rulisme/ui",
  "private": false,
  "type": "module",
  "version": "0.0.1",
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    "./styles/shadcn.css": "./src/styles/shadcn.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "watch:js": "vite build --watch",
    "watch:types": "tsc --declaration --emitDeclarationOnly --outDir dist --rootDir src --watch",
    "build": "vite build --emptyOutDir && tsc --declaration --emitDeclarationOnly --outDir dist --rootDir src",
    "dev": "bun run build && bun run --parallel watch:js watch:types",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-phone-number-input": "^3.4.18",
    "tailwind-merge": "^3.7.0",
    "react-day-picker": "^10.0.2"
  },
  "devDependencies": {
    "vite": "^8.3.2",
    "tinyglobby": "^0.2.17",
    "@types/react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "typescript": "catalog:"
  }
}
