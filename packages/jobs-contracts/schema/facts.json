{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CvEntryRefFactValue": {
      "type": "object",
      "properties": {
        "cv_id": {
          "type": "string",
          "minLength": 1
        },
        "cv_entry_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["cv_id", "cv_entry_id"]
    },
    "LanguageFactValue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8
          },
          "level": {
            "$ref": "#/$defs/LanguageLevel"
          }
        },
        "required": ["code", "level"]
      }
    },
    "LanguageLevel": {
      "type": "string",
      "enum": ["native", "fluent", "professional", "conversational", "basic"]
    },
    "WorkAuthFactValue": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/WorkAuthStatus"
        }
      },
      "required": ["status"]
    },
    "WorkAuthStatus": {
      "type": "string",
      "enum": [
        "citizen",
        "permanent_resident",
        "work_visa",
        "needs_sponsorship",
        "none"
      ]
    }
  }
}
