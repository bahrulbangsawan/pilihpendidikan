{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SkillsDictionary": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "description": {
          "type": "string"
        },
        "skills": {
          "minItems": 150,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "enum": [
                  "language",
                  "framework",
                  "database",
                  "cloud",
                  "devops",
                  "data",
                  "mobile",
                  "testing",
                  "security",
                  "design",
                  "practice",
                  "platform"
                ]
              },
              "synonyms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["id", "label", "category", "synonyms"]
          }
        }
      },
      "required": ["version", "description", "skills"]
    },
    "TitleFamilies": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "description": {
          "type": "string"
        },
        "seniority_words": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "titles": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["id", "label", "titles"]
          }
        }
      },
      "required": ["version", "description", "seniority_words", "families"]
    }
  }
}
