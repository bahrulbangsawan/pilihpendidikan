    {
      "id": "workday",
      "version": "0.9.0",
      "min_cli_version": "0.1.0",
      "display_name": "Workday",
      "status": "opt_in",
      "capabilities": {
        "discovery": true,
        "pagination": "offset",
        "detail": true,
        "structured_fields": [
          "source_job_ref",
          "title",
          "locations",
          "posted_at",
          "apply_url"
        ],
        "auth_required": false,
        "browser_required": false,
        "incremental": ["content_hash"],
        "application_support": "unknown",
        "application_api": "none"
      },
      "restrictions": {
        "robots_respected": true,
        "tos_notes": "Undocumented, often bot-protected endpoint. Opt in per tenant; one request at a time with at least 3 s between requests. The tenant is disabled on the first denial or challenge.",
        "requires_opt_in": true,
        "stop_on": ["access_denied", "challenge_detected", "rate_limited"]
      },
      "rate_limits": {
        "per_domain_concurrency": 1,
        "min_delay_ms": 3000,
        "max_pages": 50
      },
      "automation": {
        "headless_ok": false,
        "auto_ok": false,
        "ats_hosts": ["myworkdayjobs.com"],
        "confirmation_url_patterns": [],
        "confirmation_selectors": []
      },
      "config_schema": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "title": "Tenant"
          },
          "wd_host_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "title": "Host number (wdN)"
          },
          "site": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
            "title": "Career site"
          },
          "search_text": {
            "title": "Search text",
            "type": "string",
            "maxLength": 200
          },
          "disabled_reason": {
            "title": "Disabled because",
            "type": "string",
            "enum": ["challenge", "access_denied", "rate_limited"]
          }
        },
        "required": ["tenant", "wd_host_number", "site"],
        "additionalProperties": false
      }
    },
    {
      "id": "career_page",
      "version": "1.0.0",
