{
  "version": 1,
  "adapters": [
    {
      "id": "greenhouse",
      "version": "1.0.0",
      "min_cli_version": "0.1.0",
      "display_name": "Greenhouse",
      "status": "stable",
      "capabilities": {
        "discovery": true,
        "pagination": "single_response",
        "detail": true,
        "structured_fields": [
          "source_job_ref",
          "title",
          "locations",
          "department",
          "description_text",
          "apply_url",
          "posted_at"
        ],
        "auth_required": false,
        "browser_required": false,
        "incremental": ["etag", "watermark", "content_hash"],
        "application_support": "browser_supported",
        "application_api": "employer_key_required"
      },
      "restrictions": {
        "robots_respected": true,
        "tos_notes": "Public Job Board API (no authentication for GET endpoints). Applications go through the hosted form in the browser; the application API needs an employer key.",
        "requires_opt_in": false,
        "stop_on": [
          "access_denied",
          "challenge_detected",
          "source_closed",
          "schema_invalid"
        ]
      },
      "rate_limits": {
        "per_domain_concurrency": 2,
        "min_delay_ms": 1000,
        "max_pages": 50
      },
      "automation": {
        "headless_ok": true,
        "auto_ok": true,
        "ats_hosts": [
          "boards.greenhouse.io",
          "job-boards.greenhouse.io",
          "job-boards.eu.greenhouse.io"
        ],
        "confirmation_url_patterns": [
          "/confirmation(?:[/?#]|$)",
          "[?&][^=&#]*submitted"
        ],
        "confirmation_selectors": [
          "#application_confirmation",
          "#application-confirmation",
          "[data-testid=\"application-confirmation\"]"
        ]
      },
      "config_schema": {
        "type": "object",
        "properties": {
          "board_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
            "title": "Board token"
          }
        },
        "required": ["board_token"],
        "additionalProperties": false
      }
    },
    {
      "id": "lever",
      "version": "1.0.0",
      "min_cli_version": "0.1.0",
      "display_name": "Lever",
      "status": "stable",
      "capabilities": {
        "discovery": true,
        "pagination": "offset",
        "detail": true,
        "structured_fields": [
          "source_job_ref",
          "title",
          "locations",
          "department",
          "workplace_type",
          "employment_type",
          "description_text",
          "apply_url",
          "posted_at",
          "salary"
        ],
        "auth_required": false,
        "browser_required": false,
        "incremental": ["content_hash"],
        "application_support": "browser_supported",
        "application_api": "employer_key_required"
      },
      "restrictions": {
        "robots_respected": true,
        "tos_notes": "Public Postings API (api.lever.co, EU: api.eu.lever.co). Applications go through the browser form at jobs.lever.co; the apply API needs a key.",
        "requires_opt_in": false,
        "stop_on": [
          "access_denied",
          "challenge_detected",
          "source_closed",
          "schema_invalid"
        ]
      },
      "rate_limits": {
        "per_domain_concurrency": 2,
        "min_delay_ms": 1000,
        "max_pages": 50
      },
      "automation": {
        "headless_ok": true,
        "auto_ok": true,
        "ats_hosts": ["jobs.lever.co", "jobs.eu.lever.co"],
        "confirmation_url_patterns": [
          "^https://jobs(?:\\.eu)?\\.lever\\.co/[^/]+/[^/]+/thanks(?:[/?#]|$)"
        ],
        "confirmation_selectors": [
          ".application-confirmation",
          "[data-qa=\"msg-submit-success\"]"
        ]
      },
      "config_schema": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
            "title": "Lever site"
          },
          "region": {
            "title": "Region",
            "type": "string",
            "enum": ["global", "eu"]
          },
          "filters": {
            "title": "Filters",
            "type": "object",
            "properties": {
              "location": {
                "type": "string",
                "maxLength": 200
              },
              "commitment": {
                "type": "string",
                "maxLength": 200
              },
              "team": {
                "type": "string",
                "maxLength": 200
              },
              "department": {
                "type": "string",
                "maxLength": 200
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["site"],
        "additionalProperties": false
      }
    },
