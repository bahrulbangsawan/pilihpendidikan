      },
      "restrictions": {
        "robots_respected": true,
        "tos_notes": "Static careers page: JSON-LD JobPosting first, then configured selectors. A link to a known ATS host is redirected to that ATS adapter.",
        "requires_opt_in": false,
        "stop_on": [
          "access_denied",
          "challenge_detected",
          "unsupported_content"
        ]
      },
      "rate_limits": {
        "per_domain_concurrency": 1,
        "min_delay_ms": 2000,
        "max_pages": 50
      },
      "automation": {
        "headless_ok": false,
        "auto_ok": false,
        "ats_hosts": [],
        "confirmation_url_patterns": [],
        "confirmation_selectors": []
      },
      "config_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https?:\\/\\/",
            "title": "Careers page URL"
          },
          "item_css": {
            "title": "Item selector",
            "type": "string",
            "maxLength": 300
          },
          "fields": {
            "title": "Field selectors",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 40
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 300
            }
          },
          "next_css": {
            "title": "Next-page selector",
            "type": "string",
            "maxLength": 300
          },
          "allow_browser": {
            "title": "Allow browser",
            "type": "boolean"
          }
        },
        "required": ["url"],
        "additionalProperties": false
      }
    },
