// apps/jobs-scraper — the cloud scraper (job-tracker-spec/24, D-38).
//
// A Worker with no public route (`workers_dev: false`, no `routes`): only the
// `SCRAPER` service binding of apps/api reaches it. It forwards `/healthz` and
// `/v1/{scrape,probe,directory}` to a Cloudflare Container running the Python
// service in ./python (pilih-scraper over the pilih-jobs Scrapling engine).
//
// The image is built from the repository root (`image_build_context`) because
// it installs apps/jobs-cli next to the service. `wrangler deploy` needs a
// running Docker daemon; `bun run build` (CI) bundles only the Worker.
// Containers need the Workers Paid plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobs-scraper-pilihpendidikan",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    // Container instances a domain is spread over (hash(domain) % size). Keep
    // ≤ containers[0].max_instances.
    "SCRAPER_POOL_SIZE": "3"
  },
  "containers": [
    {
      "class_name": "ScraperContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "max_instances": 3,
      // 1/4 vCPU, 1 GiB, 4 GB disk. Opt-in browser sources may need
      // "standard-1" (4 GiB) — see README § Limits.
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCRAPER_CONTAINER",
        "class_name": "ScraperContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScraperContainer"]
    }
  ]
}
