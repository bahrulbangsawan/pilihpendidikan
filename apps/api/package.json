{
  "name": "api",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "cf-typegen": "wrangler types --config wrangler.jsonc --include-env=false",
    "dev": "wrangler dev --config wrangler.jsonc --port 8788",
    "build": "bun run cf-typegen && wrangler deploy --config wrangler.jsonc --dry-run --outdir dist",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:jobs:local": "wrangler d1 migrations apply JOBS_DB --local",
    "db:seed:local": "bun scripts/seed-local.ts",
    "db:seed:demo": "bun scripts/seed-demo.ts",
    "typecheck": "bun run cf-typegen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "scoring:eval": "bun scripts/scoring-eval.ts",
    "analytics:rebuild": "bun scripts/analytics-rebuild.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@pilihpendidikan/cv-engine": "workspace:*",
    "@pilihpendidikan/jobs-contracts": "workspace:*",
    "agents": "^0.26.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@pilihpendidikan/config": "workspace:*",
    "@types/bun": "^1.3.0",
    "typescript": "catalog:",
    "wrangler": "^4.147.0"
  }
}
