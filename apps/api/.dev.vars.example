# Local overrides for `wrangler dev` (apps/api). Copy to `.dev.vars` (gitignored).
# Values here replace the same-named `vars` in wrangler.jsonc while running
# locally. Every credential the Worker accepts is minted by the Worker itself
# and stored hashed in D1 / KV; the only external secret is OPENAI_API_KEY
# (or OPENROUTER_API_KEY with JOBS_AI_PROVIDER=openrouter).
#
# Restart `wrangler dev` after editing; it does not hot-reload vars.
#
# First run: `bun run db:migrate:local && bun run db:migrate:jobs:local &&
# bun run db:seed:local` (the seed turns the Job Tracker flags on in the local
# DB.feature_flags; they are never vars, D-33).

# Comma-separated emails that may read and edit every user's documents.
# Leave empty unless you are testing admin behaviour. Never applies to the
# Job Tracker data (D-26).
ADMIN_EMAILS=

# Sender for sign-in emails. In local dev the EMAIL binding is simulated:
# wrangler prints each message (and the sign-in link) instead of sending it.
EMAIL_FROM=noreply@pilihpendidikan.com

# Days to keep request_log rows before the daily purge.
LOG_RETENTION_DAYS=90

# AI provider: "fake" is the deterministic provider (no network, no cost).
# Switch to "live" and set OPENAI_API_KEY to call OpenAI from your machine.
JOBS_AI_MODE=fake
OPENAI_API_KEY=
# Optional: data-residency endpoint (e.g. https://eu.api.openai.com) and the
# Responses model used for CV tailoring.
# OPENAI_BASE_URL=https://api.openai.com
# TAILOR_MODEL=gpt-6.1-sol

# Live AI provider: "openai" (default, OPENAI_API_KEY) or "openrouter"
# (OPENROUTER_API_KEY; every call asks for zero data retention). The model
# overrides default to openai/gpt-6-luna, openai/gpt-6.1-sol, openai/gpt-6-astra.
JOBS_AI_PROVIDER=openai
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_MODEL_DECISIONS=openai/gpt-6-luna
# OPENROUTER_MODEL_STRUCTURED=openai/gpt-6.1-sol
# OPENROUTER_MODEL_ESCALATION=openai/gpt-6-astra

# The dashboard origin used in render-ticket URLs and emailed links.
JOBS_APP_ORIGIN=http://localhost:4007
