// apps/api — backend Worker for cv / invoice / portfolio / jobs.pilihpendidikan.com.
//
// The D1 database and the AUTH_KV / CV_KV / RATE_LIMIT_KV namespaces were
// created on 2026-10-06 in the bisa.digital account (DEPLOY.md step 1; KV
// titles pilihpendidikan-auth, -cv, -rate-limit). `wrangler dev` does not
// touch them: local mode keys its on-disk state by binding name.
//
// INVOICE_KV, PORTFOLIO_KV and JOBS_KV are REBOUND: they point at the existing
// namespaces the documents already live in, so no invoice / portfolio / job
// data moves. CV_KV is new; its keys are copied in by scripts/migrate-cv-kv.ts.
//
// Job Tracker (job-tracker-spec/14 §3): the second D1 database JOBS_DB, the
// R2 bucket JOBS_FILES, the `jobs-ai` queue (+ DLQ) and the 5-minute cron.
// `REPLACE_WITH_JOBS_DB_ID` is filled in when the owner creates the database
// (14 §8); local mode (`wrangler dev`, `--local` migrations) never needs it.
// Kill switches are NOT vars: they live in DB.feature_flags (D-33).
//
// Secrets never live in this file — `.dev.vars` locally (see
// `.dev.vars.example`), `wrangler secret put` in production
// (`OPENAI_API_KEY`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-pilihpendidikan",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.pilihpendidikan.com", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  // `wrangler dev` would otherwise rewrite every request URL to the route's
  // host (api.pilihpendidikan.com), so emailed links and the OAuth issuer
  // would point at production while testing locally.
  "dev": {
    "port": 8788,
    "host": "localhost:8788"
  },
  "vars": {
    // Comma-separated emails that bypass per-owner scoping (support access).
    // Empty means nobody does.
    "ADMIN_EMAILS": "",
    // Sender for sign-in emails. The pilihpendidikan.com domain must be
    // onboarded to Cloudflare Email Sending before this delivers.
    "EMAIL_FROM": "noreply@pilihpendidikan.com",
    "LOG_RETENTION_DAYS": "90",
    // CLI compatibility (05 §1.7): a `X-Pilih-Client: cli/<semver>` below the
    // minimum gets 426 cli_upgrade_required on /api/v1 (except /meta).
    "JOBS_MIN_CLI_VERSION": "0.1.0",
    "JOBS_RECOMMENDED_CLI_VERSION": "0.1.0",
    // "live" calls OpenAI with OPENAI_API_KEY; "fake" (.dev.vars, tests) is
    // the deterministic provider. Optional: OPENAI_BASE_URL, TAILOR_MODEL.
    "JOBS_AI_MODE": "live",
    // Per-user AI budget (D-34): monthly cap; the daily sub-cap is $0.50.
    "JOBS_AI_MONTHLY_BUDGET_USD": "3.00",
    // The dashboard origin (render-ticket URLs, emailed links).
    "JOBS_APP_ORIGIN": "https://jobs.pilihpendidikan.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      // applications@ is the sender of server-sent email applications
      // (09 §6.2), only used behind JOBS_EMAIL_SERVER_SEND_ENABLED.
      "allowed_sender_addresses": [
        "noreply@pilihpendidikan.com",
        "applications@pilihpendidikan.com"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pilihpendidikan",
      "database_id": "d71a1734-01e5-435d-8c73-1b6b58a20b70",
      "migrations_dir": "migrations"
    },
    // Every Job Tracker record (D-02). Only src/jobs/repo/** queries it.
    {
      "binding": "JOBS_DB",
      "database_name": "pilihpendidikan-jobs",
      "database_id": "REPLACE_WITH_JOBS_DB_ID",
      "migrations_dir": "migrations-jobs"
    }
  ],
  // CV PDFs, cover letters, attachments, evidence screenshots, run logs
  // (D-05). Private: only authorized Worker routes read or write it.
  "r2_buckets": [
    {
      "binding": "JOBS_FILES",
      "bucket_name": "pilihpendidikan-jobs-files",
      "preview_bucket_name": "pilihpendidikan-jobs-files-preview"
    }
  ],
  // Durable async AI work (D-06): bulk scoring, CV tailoring, rules,
  // purge/export/rollup. Consumer values per 14 §3; the DLQ consumer never
  // leaves a record stuck (14 §6).
  "queues": {
    "producers": [{ "binding": "JOBS_AI_QUEUE", "queue": "jobs-ai" }],
    "consumers": [
      {
        "queue": "jobs-ai",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "jobs-ai-dlq",
        "max_concurrency": 10
      },
      {
        "queue": "jobs-ai-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 1
      }
    ]
  },
  "kv_namespaces": [
    // Sessions, magic-link tokens, one-time codes and OAuth state. New.
    {
      "binding": "AUTH_KV",
      "id": "b55e97957a2d43aa9edd025749c45b9e"
    },
    // CV documents (`cv:{id}`) + owner stamps (`owner:cv:{id}`). New; filled
    // by scripts/migrate-cv-kv.ts from the old shared auth namespace.
    {
      "binding": "CV_KV",
      "id": "a3521252ce5a4d5698f2001deb309076"
    },
    // Existing invoice namespace (`invoice:{id}`, `owner:inv:{id}`).
    {
      "binding": "INVOICE_KV",
      "id": "5c3724f8c1c340cf9dc0230217e98a4b"
    },
    // Existing portfolio namespace (`portfolio:{id}`, `owner:portfolio:{id}`).
    {
      "binding": "PORTFOLIO_KV",
      "id": "ffd22e60a94742f3bb484f0f0d2d2f95",
      "preview_id": "981ccf32fa074260b33f8f152c906490"
    },
    // Existing jobs namespace (`job:{id}`, `owner:job:{id}`).
    {
      "binding": "JOBS_KV",
      "id": "73682a585fbd48dcbc996d90e7ea4511",
      "preview_id": "beeb69315ddb44819808a1a4166d0796"
    },
    // Per-IP / per-email rate-limit counters. New.
    {
      "binding": "RATE_LIMIT_KV",
      "id": "239f7033653145b489b400663dd9fe1a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "PilihMcpServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PilihMcpServer"]
    }
  ],
  // `0 3 * * *`: request_log purge + daily jobs (retention, file retention,
  // analytics rollup). `*/5 * * * *`: lease reaper, approval and task expiry.
  // Dispatched by `controller.cron` in src/jobs/cron/index.ts.
  "triggers": {
    "crons": ["0 3 * * *", "*/5 * * * *"]
  }
}
